# Base de datos de producción. En local se puede usar sqlite:///./stefany_cloud.db
DATABASE_URL=postgresql://user:password@host:5432/stefany_cloud

APP_PASSWORD=replace-with-the-application-password
JWT_SECRET_KEY=replace-with-the-same-long-random-secret-as-the-frontend
FRONTEND_URL=https://app.example.com

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@example.com

DEFAULT_TIMEZONE=Europe/Madrid
REMINDER_GRACE_MINUTES=15
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=26214400
